{
  "name": "gladys-gemini-tts",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration that gives Gladys a Gemini voice (Gemini 3.8 Flash TTS, 30 voices, a speaking style) with your own Gemini API key: free tier or monthly budget, clip cache, usage widget, scene triggers.",
  "homepage": "https://github.com/William-De71/gladys-gemini-tts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-gemini-tts.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "gemini",
    "google-ai-studio",
    "text-to-speech",
    "tts",
    "home-automation"
  ]
}
